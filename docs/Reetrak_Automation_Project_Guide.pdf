1 0 0 1 50 326 Tm (@Test) Tj
1 0 0 1 50 310 Tm (public void forgotPasswordPageShouldOpen\(\) {) Tj
1 0 0 1 50 294 Tm (    LoginPage loginPage = new LoginPage\(driver\);) Tj
1 0 0 1 50 278 Tm (    loginPage.open\(baseUrl\);) Tj
1 0 0 1 50 262 Tm (    loginPage.openForgotPassword\(\);) Tj
1 0 0 1 50 246 Tm (    Assert.assertTrue\(driver.getCurrentUrl\(\).contains\("forgot-password"\)\);) Tj
1 0 0 1 50 230 Tm (}) Tj
